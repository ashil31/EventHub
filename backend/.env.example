# Application
NODE_ENV=development
PORT=3000

# Database (used by Phase 2 — required now so the config contract is stable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventhub

# Auth (used by a later phase — required now so the config contract is stable)
JWT_SECRET=replace-this-in-development-with-a-long-random-value
JWT_EXPIRES_IN=15m

# CORS — optional. Origin of the deployed React frontend.
# If unset, CORS defaults to allowing localhost during development only.
FRONTEND_URL=http://localhost:5173

# Rate limiting — all optional, shown here with their defaults.
# General API: THROTTLE_LIMIT requests per THROTTLE_TTL seconds, per user
# (or per IP if unauthenticated).
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Stricter limit specifically for POST /auth/register and POST /auth/login
# (always tracked by IP, since there's no authenticated user yet).
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5
