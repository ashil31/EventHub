# Monorepo-wide ignores. Each package (backend/, frontend/) also has its
# own more specific .gitignore for its own build output, dependencies,
# and env files.

# OS
.DS_Store

# IDE
.idea
.vscode/*
!.vscode/extensions.json

# Fallback patterns in case a package's own .gitignore is ever missing
**/node_modules
**/dist
**/.env
**/.env.local
**/.env.*.local
.playwright-mcp/*
