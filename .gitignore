/prisma.config.js
/prisma.config.js.map
/prisma.config.d.ts
/prisma.config.d.ts.map
/prisma/*.js
/prisma/*.js.map
/prisma/*.d.ts

# logs
*.log
npm-debug.log*

# environment
.env
.env.local
.env.*.local

# OS
.DS_Store

# IDE
.idea
.vscode/*
!.vscode/extensions.json

# misc
*.tsbuildinfo
